# =============================================================================
# Environment Configuration
# Copy this file to .env and fill in the values for your environment.
# =============================================================================

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=gpt-5.1
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search ---
AZURE_SEARCH_ENDPOINT=https://your-search-service.search.windows.net
AZURE_SEARCH_KEY=your-azure-search-key
MAIN_DATA_INDEX_NAME=your-main-index
SEMANTIC_INDEX_NAME=your-semantic-index

# --- Agent Config ---
MAX_ITERATIONS=3
CONFIDENCE_HIGH=0.85
CONFIDENCE_MEDIUM=0.65

# --- Database Backend ---
# Set to "postgres" for local development, "databricks" for development/staging
DB_BACKEND=postgres

# --- Metadata Table Name ---
# Local (PostgreSQL):       metadata_gcpl
# Development (Databricks): silver.silver_deterministic_ai_document_data
METADATA_TABLE_NAME=metadata_gcpl

# --- PostgreSQL (local development) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_DB=qt328pp

# --- Databricks SQL Connector (development environment) ---
# Only required when DB_BACKEND=databricks
DATABRICKS_SERVER_HOSTNAME=your-workspace.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
DATABRICKS_ACCESS_TOKEN=dapi_your_access_token
